---
import HeaderLink from './HeaderLink.astro';

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { overlay }]}>
	<nav class="nav-shell" aria-label="主导航">
		<a class="brand" href="/" aria-label="Reynor's Blog 首页">
			<span class="brand-mark" aria-hidden="true">R</span>
			<strong>Reynor's Blog</strong>
		</a>
		<div class="nav-links">
			<HeaderLink href="/">主页</HeaderLink>
			<HeaderLink href="/blog">技术</HeaderLink>
			<HeaderLink href="/projects">项目</HeaderLink>
			<HeaderLink href="/reading">阅读</HeaderLink>
			<HeaderLink href="/notes">随笔</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 10px 0;
		border-bottom: 1px solid rgba(var(--line), 0.7);
		background: rgba(255, 255, 255, 0.84);
		backdrop-filter: blur(18px) saturate(135%);
	}

	.site-header.overlay {
		position: absolute;
		width: 100%;
		border-bottom: 0;
		background: transparent;
		backdrop-filter: none;
	}

	.nav-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 36px, 1320px);
		min-height: 54px;
		margin: 0 auto;
		padding: 0 12px 0 16px;
		gap: 28px;
	}

	.overlay .nav-shell {
		border: 1px solid rgba(255, 255, 255, 0.66);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.42);
		box-shadow: 0 12px 36px rgba(80, 111, 150, 0.08);
		backdrop-filter: blur(16px) saturate(130%);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		flex: 0 0 auto;
		color: rgb(var(--ink));
	}

	.brand:hover {
		color: var(--accent-strong);
	}

	.brand-mark {
		display: inline-grid;
		width: 30px;
		height: 30px;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(145deg, rgba(134, 169, 212, 0.92), rgba(239, 191, 210, 0.88));
		box-shadow: 0 7px 18px rgba(95, 130, 178, 0.18);
		color: #fff;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.98rem;
		font-weight: 700;
	}

	.brand strong {
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.02rem;
		letter-spacing: -0.01em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2px;
	}

	@media (max-width: 720px) {
		.site-header {
			padding: 8px 0;
		}

		.nav-shell {
			width: min(100% - 18px, 1320px);
			padding: 8px 10px;
			flex-wrap: wrap;
			gap: 6px;
		}

		.brand {
			padding-left: 4px;
		}

		.nav-links {
			width: 100%;
			justify-content: flex-start;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.nav-links::-webkit-scrollbar {
			display: none;
		}
	}
</style>
