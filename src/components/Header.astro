---
import HeaderLink from './HeaderLink.astro';

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { overlay }]}>
	<nav class="nav-shell" aria-label="主导航">
		<a class="brand" href="/" aria-label="Reynor's Blog 首页">
			<span class="brand-mark" aria-hidden="true">R</span>
			<strong>Reynor's Blog</strong>
		</a>
		<div class="nav-actions">
			<div class="nav-links">
				<HeaderLink href="/">主页</HeaderLink>
				<HeaderLink href="/blog">技术</HeaderLink>
				<HeaderLink href="/projects">项目</HeaderLink>
				<HeaderLink href="/reading">阅读</HeaderLink>
				<HeaderLink href="/notes">随笔</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="切换到夜间模式" title="切换到夜间模式">
				<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="3.6" />
					<path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
				</svg>
				<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" />
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const syncThemeControls = () => {
		const isDark = document.documentElement.dataset.theme === 'dark';

		document.querySelectorAll('[data-theme-toggle]').forEach((control) => {
			if (!(control instanceof HTMLButtonElement)) return;
			control.setAttribute('aria-pressed', String(isDark));
			control.setAttribute('aria-label', isDark ? '切换到白天模式' : '切换到夜间模式');
			control.title = isDark ? '切换到白天模式' : '切换到夜间模式';

			if (control.dataset.themeBound === 'true') return;
			control.dataset.themeBound = 'true';
			control.addEventListener('click', () => {
				const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = nextTheme;
				document.documentElement.style.colorScheme = nextTheme;
				localStorage.setItem('reynor-theme', nextTheme);
				syncThemeControls();
			});
		});
	};

	document.addEventListener('astro:page-load', syncThemeControls);
	syncThemeControls();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 10px 0;
		border-bottom: 1px solid rgba(var(--line), 0.7);
		background: rgba(var(--glass), 0.84);
		backdrop-filter: blur(18px) saturate(135%);
	}

	.site-header.overlay {
		position: absolute;
		width: 100%;
		border-bottom: 0;
		background: transparent;
		backdrop-filter: none;
	}

	.nav-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 36px, 1320px);
		min-height: 54px;
		margin: 0 auto;
		padding: 0 12px 0 16px;
		gap: 28px;
	}

	.overlay .nav-shell {
		border: 1px solid rgba(var(--glass), 0.66);
		border-radius: 18px;
		background: rgba(var(--glass), 0.42);
		box-shadow: 0 12px 36px rgba(80, 111, 150, 0.08);
		backdrop-filter: blur(16px) saturate(130%);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		flex: 0 0 auto;
		color: rgb(var(--ink));
	}

	.brand:hover {
		color: var(--accent-strong);
	}

	.brand-mark {
		display: inline-grid;
		width: 30px;
		height: 30px;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(145deg, rgba(134, 169, 212, 0.92), rgba(239, 191, 210, 0.88));
		box-shadow: 0 7px 18px rgba(95, 130, 178, 0.18);
		color: #fff;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.98rem;
		font-weight: 700;
	}

	.brand strong {
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.02rem;
		letter-spacing: -0.01em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2px;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-width: 0;
		gap: 8px;
	}

	.theme-toggle {
		display: grid;
		width: 38px;
		height: 38px;
		padding: 0;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid rgba(var(--line), 0.72);
		border-radius: 50%;
		background: rgba(var(--card), 0.68);
		box-shadow: 0 7px 20px rgba(76, 103, 137, 0.08);
		color: var(--heading-soft);
		cursor: pointer;
		font: inherit;
	}

	.theme-toggle:hover {
		border-color: rgba(var(--accent), 0.52);
		background: linear-gradient(145deg, var(--accent-soft), var(--pink-soft));
		color: var(--accent-strong);
		transform: translateY(-1px);
	}

	.theme-toggle svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
	}

	.moon-icon {
		display: none;
	}

	:global(html[data-theme="dark"]) .sun-icon {
		display: none;
	}

	:global(html[data-theme="dark"]) .moon-icon {
		display: block;
	}

	@media (max-width: 720px) {
		.site-header {
			padding: 8px 0;
		}

		.nav-shell {
			width: min(100% - 18px, 1320px);
			padding: 8px 10px;
			flex-wrap: wrap;
			gap: 6px;
		}

		.brand {
			padding-left: 4px;
		}

		.nav-actions {
			width: 100%;
		}

		.nav-links {
			min-width: 0;
			flex: 1;
			justify-content: flex-start;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.nav-links::-webkit-scrollbar {
			display: none;
		}
	}
</style>
