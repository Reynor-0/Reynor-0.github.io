---
import { getCollection } from 'astro:content';
import { getSeriesDefinition } from '../lib/series';
import HeaderLink from './HeaderLink.astro';

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const searchPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<header class:list={['site-header', { overlay }]} data-site-header data-overlay={overlay ? 'true' : undefined}>
	<nav class="nav-shell" aria-label="主导航">
		<a class="brand" href="/" aria-label="Reynor 首页">
			<strong>Reynor</strong>
		</a>
		<div class="nav-actions">
			<button
				class="search-trigger"
				type="button"
				data-search-trigger
				aria-label="搜索文章"
				aria-expanded="false"
				aria-controls="nav-search-popover"
			>
				搜索
			</button>
			<div class="nav-links">
				<HeaderLink href="/">主页</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/series">专栏</HeaderLink>
				<HeaderLink href="/tags">标签</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="切换到夜间模式" title="切换到夜间模式">
				<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="3.6" />
					<path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
				</svg>
				<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" />
				</svg>
			</button>
			<button
				class="menu-toggle"
				type="button"
				data-menu-toggle
				aria-label="打开导航菜单"
				aria-expanded="false"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 7.5h14M5 12h14M5 16.5h14" />
				</svg>
			</button>

			<section
				class="search-popover"
				id="nav-search-popover"
				data-search-popover
				aria-label="即时搜索"
				hidden
			>
				<label class="search-field">
					<span class="sr-only">搜索标题、描述或标签</span>
					<svg viewBox="0 0 20 20" aria-hidden="true">
						<circle cx="8.5" cy="8.5" r="5.2" />
						<path d="m12.4 12.4 4 4" />
					</svg>
					<input
						type="search"
						data-search-input
						placeholder="搜索文章、标签或关键词…"
						autocomplete="off"
						spellcheck="false"
					/>
				</label>
				<p class="search-status" data-search-status aria-live="polite">输入关键词，即时查找全部文章。</p>
				<div class="search-results" data-search-results>
					{
						searchPosts.map((post) => (
							<a
								href={`/blog/${post.id}/`}
								data-search-item
								data-search-text={[
									post.data.title,
									post.data.description,
									post.data.category,
									getSeriesDefinition(post.data.series?.id)?.title ?? '',
									...post.data.tags,
								].join(' ').toLocaleLowerCase('zh-CN')}
								hidden
							>
								<strong>{post.data.title}</strong>
								<span>
									{post.data.tags.slice(0, 3).map((tag) => <small>#{tag}</small>)}
								</span>
							</a>
						))
					}
				</div>
			</section>
		</div>
	</nav>
</header>

<script>
	const syncThemeControls = () => {
		const isDark = document.documentElement.dataset.theme === 'dark';

		document.querySelectorAll('[data-theme-toggle]').forEach((control) => {
			if (!(control instanceof HTMLButtonElement)) return;
			control.setAttribute('aria-pressed', String(isDark));
			control.setAttribute('aria-label', isDark ? '切换到白天模式' : '切换到夜间模式');
			control.title = isDark ? '切换到白天模式' : '切换到夜间模式';

			if (control.dataset.themeBound === 'true') return;
			control.dataset.themeBound = 'true';
			control.addEventListener('click', () => {
				const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = nextTheme;
				document.documentElement.style.colorScheme = nextTheme;
				localStorage.setItem('reynor-theme', nextTheme);
				syncThemeControls();
				document.dispatchEvent(new CustomEvent('reynor:theme-change', { detail: { theme: nextTheme } }));
			});
		});
	};

	const bindNavigationSearch = () => {
		document.querySelectorAll('.nav-actions').forEach((actions) => {
			if (!(actions instanceof HTMLElement) || actions.dataset.searchBound === 'true') return;

			const trigger = actions.querySelector('[data-search-trigger]');
			const popover = actions.querySelector('[data-search-popover]');
			const input = actions.querySelector('[data-search-input]');
			const status = actions.querySelector('[data-search-status]');
			const items = Array.from(actions.querySelectorAll('[data-search-item]'));
			if (
				!(trigger instanceof HTMLButtonElement) ||
				!(popover instanceof HTMLElement) ||
				!(input instanceof HTMLInputElement) ||
				!(status instanceof HTMLElement)
			) return;

			actions.dataset.searchBound = 'true';

			const close = () => {
				popover.hidden = true;
				trigger.setAttribute('aria-expanded', 'false');
			};

			const open = () => {
				popover.hidden = false;
				trigger.setAttribute('aria-expanded', 'true');
				window.requestAnimationFrame(() => input.focus());
			};

			const updateResults = () => {
				const terms = input.value
					.trim()
					.toLocaleLowerCase('zh-CN')
					.split(/\s+/)
					.filter(Boolean);
				let matches = 0;

				items.forEach((item) => {
					if (!(item instanceof HTMLAnchorElement)) return;
					const haystack = item.dataset.searchText ?? '';
					const matched = terms.length > 0 && terms.every((term) => haystack.includes(term));
					const visible = matched && matches < 6;
					item.hidden = !visible;
					if (visible) matches += 1;
				});

				if (terms.length === 0) {
					status.textContent = '输入关键词，即时查找全部文章。';
				} else if (matches === 0) {
					status.textContent = '没有找到匹配文章，换个关键词试试。';
				} else {
					status.textContent = `找到 ${matches} 篇相关结果`;
				}
			};

			trigger.addEventListener('click', () => {
				if (popover.hidden) open();
				else close();
			});
			input.addEventListener('input', updateResults);
			input.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter') return;
				const firstResult = items.find((item) => item instanceof HTMLAnchorElement && !item.hidden);
				if (firstResult instanceof HTMLAnchorElement) firstResult.click();
			});
			document.addEventListener('pointerdown', (event) => {
				if (event.target instanceof Node && !actions.contains(event.target)) close();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || popover.hidden) return;
				close();
				trigger.focus();
			});
		});
	};

	const bindMobileNavigation = () => {
		document.querySelectorAll('[data-site-header]').forEach((header) => {
			if (!(header instanceof HTMLElement) || header.dataset.menuBound === 'true') return;
			const toggle = header.querySelector('[data-menu-toggle]');
			const links = header.querySelector('.nav-links');
			if (!(toggle instanceof HTMLButtonElement) || !(links instanceof HTMLElement)) return;

			header.dataset.menuBound = 'true';
			const close = () => {
				header.classList.remove('menu-open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', '打开导航菜单');
			};

			toggle.addEventListener('click', () => {
				const open = header.classList.toggle('menu-open');
				toggle.setAttribute('aria-expanded', String(open));
				toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
			});
			links.addEventListener('click', (event) => {
				if (event.target instanceof HTMLAnchorElement) close();
			});
			document.addEventListener('pointerdown', (event) => {
				if (event.target instanceof Node && !header.contains(event.target)) close();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !header.classList.contains('menu-open')) return;
				close();
				toggle.focus();
			});
		});
	};

	const syncHeaderScrollState = () => {
		document.querySelectorAll('[data-site-header][data-overlay="true"]').forEach((header) => {
			header.classList.toggle('is-scrolled', window.scrollY > 28);
		});
	};

	const initializeHeader = () => {
		syncThemeControls();
		bindNavigationSearch();
		bindMobileNavigation();
		syncHeaderScrollState();
	};

	if (document.documentElement.dataset.headerScrollBound !== 'true') {
		document.documentElement.dataset.headerScrollBound = 'true';
		window.addEventListener('scroll', syncHeaderScrollState, { passive: true });
	}
	document.addEventListener('astro:page-load', initializeHeader);
	initializeHeader();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		border-bottom: 1px solid rgba(var(--line), 0.86);
		background: rgba(var(--glass), 0.94);
		backdrop-filter: blur(14px) saturate(112%);
		transition:
			background-color 220ms ease,
			border-color 220ms ease,
			box-shadow 220ms ease;
	}

	.site-header.overlay {
		position: fixed;
		border-bottom: 0;
		background: transparent;
		backdrop-filter: none;
	}

	.site-header.overlay.is-scrolled,
	.site-header.overlay.menu-open {
		border-bottom: 1px solid rgba(var(--line), 0.82);
		background: rgba(var(--glass), 0.9);
		box-shadow: 0 8px 28px rgba(39, 58, 44, 0.055);
		backdrop-filter: blur(14px) saturate(112%);
	}

	.nav-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 48px, 1440px);
		min-height: 68px;
		margin: 0 auto;
		gap: 32px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		flex: 0 0 auto;
		color: rgb(var(--ink));
	}

	.brand:hover {
		color: var(--accent-strong);
	}

	.brand strong {
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.2rem;
		letter-spacing: 0.01em;
	}

	.nav-actions {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-width: 0;
		gap: 4px;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2px;
	}

	.search-trigger {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0.45rem 0.68rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: rgb(var(--muted));
		cursor: pointer;
		font: inherit;
		font-size: 0.88rem;
		font-weight: 650;
	}

	.search-trigger:hover,
	.search-trigger[aria-expanded="true"] {
		color: var(--accent-strong);
	}

	.theme-toggle {
		display: grid;
		width: 38px;
		height: 38px;
		padding: 0;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid transparent;
		border-radius: 50%;
		background: transparent;
		color: var(--heading-soft);
		cursor: pointer;
		font: inherit;
	}

	.theme-toggle:hover {
		border-color: rgba(var(--accent), 0.34);
		background: var(--accent-soft);
		color: var(--accent-strong);
		transform: translateY(-1px);
	}

	.theme-toggle svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
	}

	.menu-toggle {
		display: none;
		width: 38px;
		height: 38px;
		padding: 0;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--ink));
		cursor: pointer;
	}

	.menu-toggle:hover,
	.menu-toggle[aria-expanded="true"] {
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	.menu-toggle svg {
		width: 19px;
		height: 19px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.7;
	}

	.moon-icon {
		display: none;
	}

	:global(html[data-theme="dark"]) .sun-icon {
		display: none;
	}

	:global(html[data-theme="dark"]) .moon-icon {
		display: block;
	}

	.search-popover {
		position: absolute;
		top: calc(100% + 14px);
		right: 84px;
		width: min(380px, calc(100vw - 28px));
		padding: 12px;
		border: 1px solid rgba(var(--line), 0.78);
		border-radius: 12px;
		background: rgba(var(--card), 0.94);
		box-shadow: 0 22px 70px rgba(39, 58, 44, 0.16);
		backdrop-filter: blur(20px) saturate(140%);
	}

	.search-popover[hidden] {
		display: none;
	}

	.search-field {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.8rem;
		gap: 9px;
		border: 1px solid rgba(var(--accent), 0.42);
		border-radius: 11px;
		background: rgba(var(--paper), 0.82);
	}

	.search-field:focus-within {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(var(--accent), 0.13);
	}

	.search-field svg {
		width: 17px;
		height: 17px;
		flex: 0 0 auto;
		fill: none;
		stroke: var(--accent-strong);
		stroke-linecap: round;
		stroke-width: 1.8;
	}

	.search-field input {
		width: 100%;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: rgb(var(--ink));
		font: inherit;
		font-size: 0.86rem;
	}

	.search-field input::placeholder {
		color: rgb(var(--muted));
	}

	.search-status {
		margin: 0;
		padding: 0.68rem 0.3rem 0.5rem;
		color: rgb(var(--muted));
		font-size: 0.73rem;
	}

	.search-results {
		display: grid;
		max-height: min(430px, 58vh);
		overflow-y: auto;
	}

	.search-results a {
		display: grid;
		padding: 0.76rem 0.7rem;
		gap: 0.4rem;
		border-top: 1px solid rgba(var(--line), 0.58);
		border-radius: 9px;
		color: rgb(var(--ink));
	}

	.search-results a[hidden] {
		display: none;
	}

	.search-results a:hover,
	.search-results a:focus-visible {
		background: var(--accent-soft);
	}

	.search-results strong {
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.search-results a > span {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}

	.search-results small {
		color: rgb(var(--muted));
		font-size: 0.67rem;
		font-weight: 700;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 720px) {
		.nav-shell {
			width: min(100% - 24px, 1440px);
			min-height: 60px;
			gap: 12px;
		}

		.brand {
			padding-left: 4px;
		}

		.nav-actions {
			position: static;
			width: auto;
		}

		.nav-links {
			position: absolute;
			top: calc(100% + 1px);
			left: 0;
			display: grid;
			width: 100%;
			padding: 10px 18px 16px;
			border-bottom: 1px solid rgba(var(--line), 0.86);
			background: rgba(var(--glass), 0.97);
			box-shadow: 0 18px 36px rgba(39, 58, 44, 0.08);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-8px);
			transition:
				opacity 180ms ease,
				transform 180ms ease;
		}

		.menu-open .nav-links {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.nav-links :global(a) {
			justify-content: center;
			min-height: 44px;
		}

		.menu-toggle {
			display: grid;
		}

		.search-popover {
			top: calc(100% + 8px);
			right: 12px;
		}
	}
</style>
