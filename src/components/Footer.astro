---
const today = new Date();
---

<footer>
	<div class="footer-shell">
		<div>
			<strong>Reynor's Blog</strong>
			<p>学习、记录，也保留那些还没有答案的问题。</p>
		</div>
		<nav aria-label="页脚导航">
			<a href="/search">搜索</a>
			<a href="/blog">文章</a>
			<a href="/tags">标签</a>
			<a href="/about">关于</a>
			<a href="https://github.com/Reynor-0" target="_blank" rel="noreferrer">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
	<div class="footer-bottom">
		<p>© {today.getFullYear()} Reynor-0</p>
		<p>Built with Astro</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 32px;
		border-top: 1px solid rgba(var(--line), 0.8);
		background:
			radial-gradient(circle at 12% 0%, rgba(239, 191, 210, 0.23), transparent 24rem),
			linear-gradient(135deg, rgba(var(--soft), 0.86), rgb(var(--card)) 72%);
		color: rgb(var(--muted));
	}

	.footer-shell {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		width: min(100% - 40px, 1120px);
		margin: 0 auto;
		padding: 48px 0 34px;
		gap: 40px;
	}

	.footer-shell strong {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.15rem;
	}

	.footer-shell p {
		margin: 0;
		font-size: 0.92rem;
	}

	.footer-shell nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px 20px;
	}

	.footer-shell nav a {
		color: rgb(var(--muted));
		font-size: 0.9rem;
	}

	.footer-shell nav a:hover {
		color: var(--accent-strong);
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 40px, 1120px);
		margin: 0 auto;
		padding: 20px 0 24px;
		border-top: 1px solid rgba(var(--line), 0.78);
		font-size: 0.78rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 680px) {
		.footer-shell {
			width: min(100% - 24px, 1120px);
			padding-top: 40px;
			flex-direction: column;
		}

		.footer-shell nav {
			justify-content: flex-start;
		}

		.footer-bottom {
			align-items: flex-start;
			width: min(100% - 24px, 1120px);
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
