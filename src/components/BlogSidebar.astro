---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_ORDER } from '../lib/blog';

type Props = {
	posts: CollectionEntry<'blog'>[];
	currentId?: string;
	overviewActive?: boolean;
};

const { posts, currentId, overviewActive = false } = Astro.props;
const groups = CATEGORY_ORDER
	.map((category) => ({
		category,
		posts: posts.filter((post) => post.data.category === category),
	}))
	.filter((group) => group.posts.length > 0);
---

<aside class="blog-sidebar" aria-label="文章分类导航" data-blog-sidebar>
	<div class="sidebar-head">
		<a class:list={['overview-link', { active: overviewActive }]} href="/blog">
			<span>文章导览</span>
			<small>{posts.length}</small>
		</a>
		<button type="button" data-collapse-all aria-label="收拢全部文章分类" title="收拢全部分类">
			<svg viewBox="0 0 20 20" aria-hidden="true">
				<path d="m5.5 8 4.5-4 4.5 4M5.5 12l4.5 4 4.5-4" />
			</svg>
		</button>
	</div>

	<nav aria-label="按主题浏览文章">
		{
			groups.map((group) => {
				const containsCurrent = group.posts.some((post) => post.id === currentId);

				return (
					<details open={containsCurrent}>
						<summary>
							<span class="category-mark" aria-hidden="true" />
							<strong>{group.category}</strong>
							<small>{group.posts.length}</small>
							<svg viewBox="0 0 20 20" aria-hidden="true">
								<path d="m6.5 8 3.5 3.5L13.5 8" />
							</svg>
						</summary>
						<div class="article-links">
							{group.posts.map((post) => (
								<a
									class:list={{ active: post.id === currentId }}
									href={`/blog/${post.id}/`}
									aria-current={post.id === currentId ? 'page' : undefined}
								>
									<span>{post.data.title}</span>
								</a>
							))}
						</div>
					</details>
				);
			})
		}
	</nav>
</aside>

<script>
	const bindSidebarCollapse = () => {
		document.querySelectorAll('[data-blog-sidebar]').forEach((sidebar) => {
			const button = sidebar.querySelector('[data-collapse-all]');
			if (!(button instanceof HTMLButtonElement) || button.dataset.bound === 'true') return;
			button.dataset.bound = 'true';
			button.addEventListener('click', () => {
				sidebar.querySelectorAll('details[open]').forEach((details) => {
					if (details instanceof HTMLDetailsElement) details.open = false;
				});
				button.blur();
			});
		});
	};

	document.addEventListener('astro:page-load', bindSidebarCollapse);
	bindSidebarCollapse();
</script>

<style>
	.blog-sidebar {
		position: sticky;
		top: 92px;
		max-height: calc(100vh - 120px);
		overflow-y: auto;
		padding: 10px 10px 12px;
		border: 1px solid rgba(var(--line), 0.72);
		border-radius: 16px;
		background:
			radial-gradient(circle at 0 0, rgba(239, 191, 210, 0.12), transparent 11rem),
			rgba(var(--card), 0.82);
		box-shadow: 0 14px 40px rgba(76, 103, 137, 0.07);
		scrollbar-width: thin;
		scrollbar-color: rgba(134, 169, 212, 0.36) transparent;
	}

	.sidebar-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 8px;
		gap: 6px;
	}

	.overview-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-width: 0;
		min-height: 42px;
		padding: 0 0.78rem;
		flex: 1;
		border-radius: 10px;
		color: rgb(var(--muted));
		font-size: 0.91rem;
		font-weight: 800;
	}

	.overview-link:hover,
	.overview-link.active {
		background: linear-gradient(135deg, var(--accent-soft), rgba(253, 240, 245, 0.72));
		color: var(--accent-strong);
	}

	.sidebar-head button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 1px solid rgba(var(--line), 0.76);
		border-radius: 9px;
		background: rgba(var(--card), 0.7);
		color: rgb(var(--muted));
		cursor: pointer;
		font: inherit;
	}

	.sidebar-head button:hover {
		border-color: rgba(var(--accent), 0.42);
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	.sidebar-head button svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.overview-link small,
	summary small {
		color: rgb(var(--muted));
		font-size: 0.7rem;
		font-weight: 800;
	}

	nav {
		display: grid;
		gap: 4px;
	}

	details {
		border-top: 1px solid rgba(var(--line), 0.58);
	}

	summary {
		display: grid;
		grid-template-columns: 8px minmax(0, 1fr) auto 18px;
		align-items: center;
		min-height: 46px;
		padding: 0 0.55rem;
		gap: 9px;
		border-radius: 9px;
		color: var(--heading-soft);
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		background: rgba(237, 245, 253, 0.62);
		color: var(--heading);
	}

	summary:focus-visible {
		outline: 3px solid rgba(134, 169, 212, 0.32);
		outline-offset: 1px;
	}

	summary strong {
		min-width: 0;
		font-size: 0.9rem;
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.category-mark {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: linear-gradient(145deg, var(--accent), var(--pink));
		box-shadow: 0 0 0 4px rgba(134, 169, 212, 0.1);
	}

	summary svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		transition: transform 180ms ease;
	}

	details[open] summary {
		color: var(--heading);
	}

	details[open] summary svg {
		transform: rotate(180deg);
	}

	.article-links {
		position: relative;
		display: grid;
		gap: 2px;
		margin: 0 0 8px 11px;
		padding-left: 13px;
	}

	.article-links::before {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 0;
		width: 1px;
		background: linear-gradient(var(--accent), rgba(239, 191, 210, 0.48));
		content: "";
		opacity: 0.44;
	}

	.article-links a {
		position: relative;
		display: block;
		padding: 0.58rem 0.62rem;
		border-radius: 8px;
		color: rgb(var(--muted));
	}

	.article-links a::before {
		position: absolute;
		top: 50%;
		left: -16px;
		width: 5px;
		height: 5px;
		border: 1px solid rgba(134, 169, 212, 0.58);
		border-radius: 50%;
		background: rgb(var(--card));
		content: "";
		transform: translateY(-50%);
	}

	.article-links a:hover {
		background: rgba(237, 245, 253, 0.62);
		color: var(--heading);
	}

	.article-links a.active {
		background: linear-gradient(135deg, rgba(237, 245, 253, 0.96), rgba(253, 240, 245, 0.66));
		color: var(--accent-strong);
		font-weight: 800;
	}

	.article-links a.active::before {
		border-color: var(--accent);
		background: var(--accent);
		box-shadow: 0 0 0 3px rgba(134, 169, 212, 0.14);
	}

	.article-links span {
		display: -webkit-box;
		overflow: hidden;
		font-size: 0.82rem;
		line-height: 1.42;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	@media (max-width: 780px) {
		.blog-sidebar {
			position: static;
			max-height: none;
			padding: 8px;
		}

		summary {
			min-height: 48px;
		}
	}
</style>
