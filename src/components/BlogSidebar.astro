---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_ORDER } from '../lib/blog';
import { SERIES_DEFINITIONS, getSeriesPosts } from '../lib/series';

type Props = {
	posts: CollectionEntry<'blog'>[];
	currentId?: string;
	overviewActive?: boolean;
};

const { posts, currentId, overviewActive = false } = Astro.props;
const groups = CATEGORY_ORDER
	.map((category) => {
		const series = SERIES_DEFINITIONS.filter((definition) => definition.category === category)
			.map((definition) => ({
				definition,
				posts: getSeriesPosts(posts, definition.id),
			}))
			.filter((item) => item.posts.length > 0);
		const standalonePosts = posts.filter(
			(post) => post.data.category === category && post.data.series === undefined,
		);

		return {
			category,
			standalonePosts,
			series,
			count: standalonePosts.length + series.reduce((total, item) => total + item.posts.length, 0),
		};
	})
	.filter((group) => group.count > 0);
---

<aside class="blog-sidebar" aria-label="文章分类导航" data-blog-sidebar>
	<div class="sidebar-head">
		<a class:list={['overview-link', { active: overviewActive }]} href="/blog">
			<span>文章导览</span>
			<small>{posts.length}</small>
		</a>
		<button type="button" data-collapse-all aria-label="收拢全部文章分类" title="收拢全部分类">
			<svg viewBox="0 0 20 20" aria-hidden="true">
				<path d="m5.5 8 4.5-4 4.5 4M5.5 12l4.5 4 4.5-4" />
			</svg>
		</button>
	</div>

	<nav aria-label="按主题浏览文章">
		{
			groups.map((group) => {
				const containsCurrent =
					group.standalonePosts.some((post) => post.id === currentId) ||
					group.series.some((series) => series.posts.some((post) => post.id === currentId));

				return (
					<details class="category-group" open={containsCurrent}>
						<summary>
							<span class="category-mark" aria-hidden="true" />
							<strong>{group.category}</strong>
							<small>{group.count}</small>
							<svg viewBox="0 0 20 20" aria-hidden="true">
								<path d="m6.5 8 3.5 3.5L13.5 8" />
							</svg>
						</summary>
						<div class="article-links">
							{group.series.map((series) => {
								const seriesActive = series.posts.some((post) => post.id === currentId);
								return (
									<details class="series-group" open={seriesActive}>
										<summary>
											<span class="series-mark" aria-hidden="true">
												<svg viewBox="0 0 18 18">
													<path d="M3.5 3.5h8A2 2 0 0 1 13.5 5v9H5.5a2 2 0 0 1-2-2V3.5Z" />
													<path d="M5.5 11.5h8" />
												</svg>
											</span>
											<strong>{series.definition.title}</strong>
											<small>{series.posts.length}</small>
											<svg class="series-chevron" viewBox="0 0 20 20" aria-hidden="true">
												<path d="m6.5 8 3.5 3.5L13.5 8" />
											</svg>
										</summary>
										<div class="series-links">
											<a class="series-overview" href={`/series/${series.definition.id}/`}>
												<span>专栏目录</span>
											</a>
											{series.posts.map((post) => (
												<a
													class:list={{ active: post.id === currentId }}
													href={`/blog/${post.id}/`}
													aria-current={post.id === currentId ? 'page' : undefined}
												>
													<b>{String(post.data.series?.order).padStart(2, '0')}</b>
													<span>{post.data.title}</span>
												</a>
											))}
										</div>
									</details>
								);
							})}
							{group.standalonePosts.map((post) => (
								<a
									class:list={{ active: post.id === currentId }}
									href={`/blog/${post.id}/`}
									aria-current={post.id === currentId ? 'page' : undefined}
								>
									<span>{post.data.title}</span>
								</a>
							))}
						</div>
					</details>
				);
			})
		}
	</nav>
</aside>

<script>
	const bindSidebarCollapse = () => {
		document.querySelectorAll('[data-blog-sidebar]').forEach((sidebar) => {
			const button = sidebar.querySelector('[data-collapse-all]');
			if (!(button instanceof HTMLButtonElement) || button.dataset.bound === 'true') return;
			button.dataset.bound = 'true';
			button.addEventListener('click', () => {
				sidebar.querySelectorAll('details[open]').forEach((details) => {
					if (details instanceof HTMLDetailsElement) details.open = false;
				});
				button.blur();
			});
		});
	};

	document.addEventListener('astro:page-load', bindSidebarCollapse);
	bindSidebarCollapse();
</script>

<style>
	.blog-sidebar {
		position: sticky;
		top: 92px;
		max-height: calc(100vh - 120px);
		overflow-y: auto;
		padding: 0 14px 12px 0;
		border-right: 1px solid rgba(var(--line), 0.88);
		background: transparent;
		scrollbar-width: thin;
		scrollbar-color: rgba(134, 169, 212, 0.36) transparent;
	}

	.sidebar-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 8px;
		gap: 6px;
	}

	.overview-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-width: 0;
		min-height: 42px;
		padding: 0 0.78rem;
		flex: 1;
		border-radius: 10px;
		color: rgb(var(--muted));
		font-size: 0.91rem;
		font-weight: 800;
	}

	.overview-link:hover,
	.overview-link.active {
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	.sidebar-head button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 1px solid rgba(var(--line), 0.76);
		border-radius: 9px;
		background: rgba(var(--card), 0.7);
		color: rgb(var(--muted));
		cursor: pointer;
		font: inherit;
	}

	.sidebar-head button:hover {
		border-color: rgba(var(--accent), 0.42);
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	.sidebar-head button svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.overview-link small,
	.category-group summary small {
		color: rgb(var(--muted));
		font-size: 0.7rem;
		font-weight: 800;
	}

	nav {
		display: grid;
		gap: 4px;
	}

	.category-group {
		border-top: 1px solid rgba(var(--line), 0.58);
	}

	.category-group > summary {
		display: grid;
		grid-template-columns: 8px minmax(0, 1fr) auto 18px;
		align-items: center;
		min-height: 46px;
		padding: 0 0.55rem;
		gap: 9px;
		border-radius: 9px;
		color: var(--heading-soft);
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.category-group > summary::-webkit-details-marker,
	.series-group > summary::-webkit-details-marker {
		display: none;
	}

	.category-group > summary:hover {
		background: rgba(var(--soft), 0.92);
		color: var(--heading);
	}

	.category-group > summary:focus-visible,
	.series-group > summary:focus-visible {
		outline: 3px solid rgba(120, 151, 127, 0.32);
		outline-offset: 1px;
	}

	.category-group > summary strong {
		min-width: 0;
		font-size: 0.9rem;
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.category-mark {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px rgba(120, 151, 127, 0.1);
	}

	.category-group > summary > svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		transition: transform 180ms ease;
	}

	.category-group[open] > summary {
		color: var(--heading);
	}

	.category-group[open] > summary > svg {
		transform: rotate(180deg);
	}

	.article-links {
		position: relative;
		display: grid;
		gap: 2px;
		margin: 0 0 8px 11px;
		padding-left: 13px;
	}

	.article-links::before {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 0;
		width: 1px;
		background: linear-gradient(var(--accent), rgba(239, 191, 210, 0.48));
		content: "";
		opacity: 0.44;
	}

	.article-links a {
		position: relative;
		display: block;
		padding: 0.58rem 0.62rem;
		border-radius: 8px;
		color: rgb(var(--muted));
	}

	.article-links a::before {
		position: absolute;
		top: 50%;
		left: -16px;
		width: 5px;
		height: 5px;
		border: 1px solid rgba(120, 151, 127, 0.58);
		border-radius: 50%;
		background: rgb(var(--card));
		content: "";
		transform: translateY(-50%);
	}

	.article-links a:hover {
		background: rgba(var(--soft), 0.92);
		color: var(--heading);
	}

	.article-links a.active {
		background: var(--accent-soft);
		color: var(--accent-strong);
		font-weight: 800;
	}

	.article-links a.active::before {
		border-color: var(--accent);
		background: var(--accent);
		box-shadow: 0 0 0 3px rgba(120, 151, 127, 0.14);
	}

	.article-links span {
		display: -webkit-box;
		overflow: hidden;
		font-size: 0.82rem;
		line-height: 1.42;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.series-group {
		margin: 2px 0 4px -4px;
		border-left: 1px solid rgba(var(--line), 0.88);
	}

	.series-group > summary {
		display: grid;
		grid-template-columns: 21px minmax(0, 1fr) auto 15px;
		align-items: center;
		min-height: 42px;
		padding: 0 0.46rem;
		gap: 7px;
		border-radius: 8px;
		color: var(--heading-soft);
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.series-group > summary:hover,
	.series-group[open] > summary {
		background: rgba(var(--soft), 0.92);
		color: var(--heading);
	}

	.series-group > summary strong {
		min-width: 0;
		overflow: hidden;
		font-size: 0.8rem;
		font-weight: 800;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.series-mark {
		display: grid;
		width: 20px;
		height: 20px;
		place-items: center;
		border-radius: 6px;
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	.series-mark svg {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.series-chevron {
		width: 15px;
		height: 15px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
		transition: transform 180ms ease;
	}

	.series-group[open] .series-chevron {
		transform: rotate(180deg);
	}

	.series-links {
		display: grid;
		margin: 2px 5px 7px 13px;
		padding-left: 7px;
		border-left: 1px solid rgba(var(--accent), 0.24);
	}

	.article-links .series-links a {
		display: grid;
		grid-template-columns: 22px minmax(0, 1fr);
		align-items: start;
		padding: 0.45rem 0.48rem;
		gap: 4px;
	}

	.article-links .series-links a::before {
		left: -11px;
	}

	.series-links b {
		padding-top: 0.08rem;
		color: var(--accent-strong);
		font-size: 0.62rem;
		letter-spacing: 0.04em;
	}

	.article-links .series-links .series-overview {
		display: block;
		color: var(--accent-strong);
		font-weight: 800;
	}

	.article-links .series-links .series-overview::before {
		border-color: var(--pink);
	}

	@media (max-width: 920px) {
		.blog-sidebar {
			position: static;
			max-height: none;
			padding: 8px;
			border: 0;
		}

		summary {
			min-height: 48px;
		}
	}
</style>
