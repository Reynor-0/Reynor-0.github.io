---
import type { CollectionEntry } from 'astro:content';
import { getSeriesContext, getSeriesDefinitions, getSeriesReaderPath } from '../lib/series';

type Props = {
	posts: CollectionEntry<'blog'>[];
	currentId?: string;
	readerSeriesId?: string;
};

const { posts, currentId, readerSeriesId } = Astro.props;
const definitions = await getSeriesDefinitions(posts);
const context = getSeriesContext(posts, currentId, definitions);
const firstPostId = context?.posts[0]?.id;
const chapterHref = (postId: string) =>
	readerSeriesId
		? getSeriesReaderPath(readerSeriesId, postId, firstPostId)
		: `/blog/${postId}/`;
---

{
	context && (
		<nav id="series-navigation" class="series-article-nav" aria-label={`${context.definition.title}专栏导航`}>
			<header>
				<div>
					<span>继续阅读专栏</span>
					<a href={`/series/${context.definition.id}/`}>{context.definition.title}</a>
				</div>
				<strong>
					{context.position} / {context.posts.length}
				</strong>
			</header>
			<div class="series-pager">
				{context.previous && (
					<a class="chapter-link previous" href={chapterHref(context.previous.id)}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m14.5 6-6 6 6 6" />
						</svg>
						<span>
							<small>上一篇</small>
							<strong>{context.previous.data.title}</strong>
						</span>
					</a>
				)}
				<a class="series-index-link" href={readerSeriesId ? '/series/' : `/series/${context.definition.id}/`}>
					{readerSeriesId ? '全部专栏' : '进入专栏阅读'}
				</a>
				{context.next && (
					<a class="chapter-link next" href={chapterHref(context.next.id)}>
						<span>
							<small>下一篇</small>
							<strong>{context.next.data.title}</strong>
						</span>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m9.5 6 6 6-6 6" />
						</svg>
					</a>
				)}
			</div>
		</nav>
	)
}

<style>
	.series-article-nav {
		margin: 2.4rem 0 2rem;
		padding: 1.25rem 0;
		border-top: 1px solid rgba(var(--line), 0.88);
		border-bottom: 1px solid rgba(var(--line), 0.88);
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 0.2rem 1rem;
		gap: 24px;
		border-bottom: 1px solid rgba(var(--line), 0.76);
	}

	header div {
		display: grid;
		gap: 0.1rem;
	}

	header span {
		color: rgb(var(--muted));
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	header a {
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.08rem;
		font-weight: 800;
	}

	header > strong {
		color: var(--accent-strong);
		font-size: 0.82rem;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}

	.series-pager {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: stretch;
		padding-top: 1rem;
		gap: 12px;
	}

	.chapter-link {
		display: flex;
		align-items: center;
		min-width: 0;
		padding: 0.72rem;
		gap: 9px;
		border-radius: 10px;
		color: rgb(var(--ink));
	}

	.chapter-link:hover {
		background: rgba(var(--soft), 0.82);
		color: var(--accent-strong);
	}

	.chapter-link.next {
		grid-column: 3;
		justify-content: flex-end;
		text-align: right;
	}

	.chapter-link span {
		display: grid;
		min-width: 0;
		gap: 0.15rem;
	}

	.chapter-link small {
		color: rgb(var(--muted));
		font-size: 0.7rem;
	}

	.chapter-link strong {
		display: -webkit-box;
		overflow: hidden;
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 0.83rem;
		line-height: 1.45;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.chapter-link svg {
		width: 18px;
		height: 18px;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.series-index-link {
		display: inline-flex;
		align-items: center;
		align-self: center;
		min-height: 38px;
		padding: 0 0.75rem;
		border: 1px solid rgba(var(--line), 0.86);
		border-radius: 6px;
		background: rgba(var(--card), 0.72);
		color: rgb(var(--muted));
		font-size: 0.72rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.series-index-link:hover {
		border-color: rgba(var(--accent), 0.45);
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	@media (max-width: 650px) {
		.series-article-nav {
			padding: 1rem;
		}

		.series-pager {
			grid-template-columns: 1fr;
		}

		.chapter-link,
		.chapter-link.next,
		.series-index-link {
			grid-column: 1;
		}

		.chapter-link.next {
			justify-content: space-between;
		}

		.series-index-link {
			justify-content: center;
			grid-row: 2;
		}
	}
</style>
