---
import type { CollectionEntry } from 'astro:content';
import { tagSlug } from '../lib/blog';

type Props = {
	post: CollectionEntry<'blog'>;
	compact?: boolean;
};

const { post, compact = false } = Astro.props;
---

<article class:list={['article-row', { compact }]}>
	<div class="article-copy">
		<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
		<p>{post.data.description}</p>
		<div class="article-tags" aria-label="文章标签">
			{
				post.data.tags.map((tag) => (
					<a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
				))
			}
		</div>
	</div>
	<a class="article-arrow" href={`/blog/${post.id}/`} aria-label={`阅读《${post.data.title}》`}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M7 17 17 7M8 7h9v9" />
		</svg>
	</a>
</article>

<style>
	.article-row {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 40px;
		align-items: start;
		padding: 1.55rem 0;
		gap: 24px;
		border-top: 1px solid rgba(var(--line), 0.88);
	}

	.article-row::before {
		position: absolute;
		top: -1px;
		left: 0;
		width: 0;
		height: 1px;
		background: linear-gradient(90deg, var(--accent), var(--pink));
		content: "";
		transition: width 240ms ease;
	}

	.article-row:hover::before {
		width: 100%;
	}

	.article-copy {
		min-width: 0;
	}

	.article-copy h2 {
		margin-bottom: 0.42rem;
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.28rem;
		line-height: 1.42;
	}

	.article-copy h2 a {
		color: var(--heading);
	}

	.article-copy h2 a:hover {
		color: var(--accent-strong);
	}

	.article-copy > p {
		display: -webkit-box;
		margin-bottom: 0.72rem;
		overflow: hidden;
		color: rgb(var(--muted));
		font-size: 0.9rem;
		line-height: 1.72;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.article-tags a {
		padding: 0.14rem 0.52rem;
		border: 1px solid rgba(var(--line), 0.7);
		border-radius: 999px;
		background: rgba(var(--soft), 0.68);
		color: rgb(var(--muted));
		font-size: 0.72rem;
		line-height: 1.5;
	}

	.article-tags a:hover {
		border-color: rgba(var(--pink), 0.44);
		background: var(--pink-soft);
		color: #bd6689;
	}

	.article-arrow {
		display: grid;
		width: 36px;
		height: 36px;
		margin-top: 0.12rem;
		place-items: center;
		border: 1px solid rgba(var(--line), 0.78);
		border-radius: 50%;
		color: var(--accent-strong);
	}

	.article-arrow:hover {
		border-color: rgba(var(--accent), 0.48);
		background: linear-gradient(145deg, var(--accent-soft), var(--pink-soft));
		transform: translateY(-2px);
	}

	.article-arrow svg {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.compact {
		grid-template-columns: minmax(0, 1fr) 36px;
		padding: 1.2rem 0;
		gap: 18px;
	}

	.compact .article-copy h2 {
		font-size: 1.12rem;
	}

	.compact .article-copy > p {
		-webkit-line-clamp: 1;
	}

	@media (max-width: 660px) {
		.article-row,
		.compact {
			grid-template-columns: 1fr 34px;
			gap: 10px 16px;
		}

		.article-arrow {
			grid-column: 2;
			grid-row: 1;
		}
	}
</style>
