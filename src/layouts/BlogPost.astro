---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	currentId?: string;
	headings?: Heading[];
	readingMinutes?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	currentId,
	headings = [],
	readingMinutes = 1,
} = Astro.props;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const visibleHeadings = headings.filter((heading) => heading.depth <= 3);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<div class="reading-progress" data-reading-progress aria-hidden="true"></div>
		<Header />
		<main class="docs-shell">
			<aside class="sidebar" aria-label="文章导航">
				<a class="sidebar-title" href="/blog">导览</a>
				{
					posts.map((post) => (
						<a class:list={{ active: post.id === currentId }} href={`/blog/${post.id}/`}>
							<strong>{post.data.title}</strong>
						</a>
					))
				}
			</aside>

			<article class="content">
				<nav class="crumb" aria-label="面包屑导航">
					<a href="/">主页</a>
					<span>〉</span>
					<a href="/blog">技术</a>
					<span>〉</span>
					<strong>{title}</strong>
				</nav>
				<header class="post-head">
					<p class="post-kicker">TECHNICAL FIELD NOTE</p>
					<h1>{title}</h1>
					<p>{description}</p>
					<div class="meta">
						<FormattedDate date={pubDate} />
						<span>{readingMinutes} 分钟阅读</span>
						{
							updatedDate && (
								<span>
									更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>

			<aside class="toc" aria-label="文章目录">
				<h2>目录</h2>
				{
					visibleHeadings.length > 0 ? (
						visibleHeadings.map((heading) => (
							<a class={`depth-${heading.depth}`} data-toc-link={heading.slug} href={`#${heading.slug}`}>
								{heading.text}
							</a>
						))
					) : (
						<p>暂无目录</p>
					)
				}
			</aside>
		</main>
		<Footer />
	</body>
</html>

<script>
	const readingProgress = document.querySelector('[data-reading-progress]');
	const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
	const headingPairs = tocLinks
		.map((link) => {
			const slug = link.getAttribute('data-toc-link');
			const heading = slug ? document.getElementById(slug) : null;
			return heading ? { heading, link } : null;
		})
		.filter(Boolean);

	function setActiveToc(activeLink) {
		tocLinks.forEach((link) => link.classList.remove('active'));
		activeLink?.classList.add('active');
	}

	function updateActiveToc() {
		const offset = 112;
		let current = headingPairs[0];

		for (const pair of headingPairs) {
			const top = pair.heading.getBoundingClientRect().top;
			if (top <= offset) {
				current = pair;
			} else {
				break;
			}
		}

		if (current) setActiveToc(current.link);
	}

	if (headingPairs.length > 0) {
		tocLinks.forEach((link) => {
			link.addEventListener('click', () => setActiveToc(link));
		});

		window.addEventListener('scroll', updateActiveToc, { passive: true });
		window.addEventListener('resize', updateActiveToc);
		updateActiveToc();
	}

	function updateReadingProgress() {
		if (!readingProgress) return;
		const scrollable = document.documentElement.scrollHeight - window.innerHeight;
		const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
		readingProgress.style.transform = `scaleX(${progress})`;
	}

	document.querySelectorAll('.prose pre').forEach((pre) => {
		const code = pre.querySelector('code');
		if (!code || pre.querySelector('.code-toolbar')) return;

		const toolbar = document.createElement('div');
		const language = document.createElement('span');
		const copyButton = document.createElement('button');
		const languageClass = Array.from(code.classList).find((item) => item.startsWith('language-'));

		toolbar.className = 'code-toolbar';
		language.textContent = languageClass?.replace('language-', '') || pre.dataset.language || 'CODE';
		copyButton.type = 'button';
		copyButton.textContent = '复制';
		copyButton.setAttribute('aria-label', '复制代码');
		copyButton.addEventListener('click', async () => {
			await navigator.clipboard.writeText(code.textContent || '');
			copyButton.textContent = '已复制';
			window.setTimeout(() => {
				copyButton.textContent = '复制';
			}, 1600);
		});

		toolbar.append(language, copyButton);
		pre.prepend(toolbar);
	});

	document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((heading) => {
		if (heading.querySelector('.heading-anchor')) return;
		const anchor = document.createElement('a');
		anchor.className = 'heading-anchor';
		anchor.href = `#${heading.id}`;
		anchor.textContent = '#';
		anchor.setAttribute('aria-label', `链接到 ${heading.textContent || '本节'}`);
		heading.append(anchor);
	});

	window.addEventListener('scroll', updateReadingProgress, { passive: true });
	window.addEventListener('resize', updateReadingProgress);
	updateReadingProgress();
</script>

<style>
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 100;
		width: 100%;
		height: 3px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
		will-change: transform;
	}

	.docs-shell {
		display: grid;
		grid-template-columns: 240px minmax(0, 780px) 210px;
		gap: 34px;
		align-items: start;
		width: min(100% - 40px, 1300px);
	}

	.sidebar {
		position: sticky;
		top: 92px;
		max-height: calc(100vh - 130px);
		overflow: auto;
		padding-right: 8px;
	}

	.sidebar-title {
		display: block;
		margin-bottom: 10px;
		padding: 0.72rem 0.75rem;
		border-radius: var(--radius-sm);
		color: rgb(var(--muted));
		font-weight: 800;
		font-size: 0.94rem;
		line-height: 1.35;
	}

	.sidebar-title:hover {
		background: rgba(var(--card), 0.74);
		color: rgb(var(--ink));
	}

	.sidebar a {
		display: block;
		padding: 0.72rem 0.75rem;
		border-radius: var(--radius-sm);
		color: rgb(var(--muted));
	}

	.sidebar a:hover {
		background: rgba(var(--card), 0.74);
		color: rgb(var(--ink));
	}

	.sidebar a.active {
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	.sidebar strong {
		display: block;
		font-size: 0.94rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.crumb {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 20px;
		color: rgb(var(--muted));
		font-size: 0.92rem;
	}

	.crumb a {
		color: rgb(var(--muted));
	}

	.crumb a:hover {
		color: var(--accent-strong);
	}

	.crumb strong {
		color: rgb(var(--ink));
		font-weight: 700;
	}

	.post-head {
		margin-bottom: 34px;
		padding-bottom: 28px;
		border-bottom: 1px solid rgba(var(--line), 0.92);
	}

	.post-kicker {
		margin-bottom: 0.7rem;
		color: var(--accent-strong) !important;
		font-size: 0.72rem !important;
		font-weight: 900;
		letter-spacing: 0.15em;
	}

	h1 {
		font-size: clamp(2.2rem, 5vw, 3.25rem);
	}

	.post-head p {
		max-width: 720px;
		color: rgb(var(--muted));
		font-size: 1.04rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 18px;
		color: rgb(var(--muted));
		font-size: 0.92rem;
	}

	.meta > * + *::before {
		margin-right: 14px;
		color: rgb(var(--line));
		content: "•";
	}

	.prose {
		padding-bottom: 24px;
		font-size: 1.01rem;
	}

	.prose :global(h2) {
		position: relative;
		margin-top: 2.4rem;
		padding-top: 0.2rem;
		font-size: 1.62rem;
	}

	.prose :global(h3) {
		position: relative;
		margin-top: 1.7rem;
		font-size: 1.18rem;
	}

	.prose :global(p),
	.prose :global(li) {
		color: rgb(var(--ink));
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.35rem;
	}

	.prose :global(.heading-anchor) {
		margin-left: 0.45rem;
		color: rgba(134, 169, 212, 0.52);
		font-weight: 500;
		opacity: 0;
	}

	.prose :global(h2:hover .heading-anchor),
	.prose :global(h3:hover .heading-anchor),
	.prose :global(.heading-anchor:focus-visible) {
		opacity: 1;
	}

	.prose :global(pre:has(.code-toolbar)) {
		padding-top: 3.3rem;
	}

	.prose :global(.code-toolbar) {
		position: absolute;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 0.58rem 0.8rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.09);
		color: rgba(255, 255, 255, 0.5);
		font-family: var(--font-atkinson), sans-serif;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.prose :global(.code-toolbar button) {
		padding: 0.18rem 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 5px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.7);
		cursor: pointer;
		font: inherit;
		letter-spacing: 0;
	}

	.prose :global(.code-toolbar button:hover) {
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
	}

	.toc {
		position: sticky;
		top: 92px;
		max-height: calc(100vh - 130px);
		overflow: auto;
		padding-left: 18px;
		border-left: 1px solid rgba(var(--line), 0.95);
	}

	.toc h2 {
		margin-bottom: 0.65rem;
		font-size: 0.98rem;
	}

	.toc a,
	.toc p {
		display: block;
		margin: 0;
		padding: 0.34rem 0;
		color: rgb(var(--muted));
		font-size: 0.9rem;
		line-height: 1.35;
	}

	.toc a:hover {
		color: rgb(var(--ink));
	}

	.toc a:focus,
	.toc a:visited {
		color: rgb(var(--muted));
	}

	.toc a.active {
		color: var(--accent-strong);
		font-weight: 800;
	}

	.toc .depth-3 {
		padding-left: 0.9rem;
		font-size: 0.86rem;
	}

	@media (max-width: 1080px) {
		.docs-shell {
			grid-template-columns: 230px minmax(0, 1fr);
		}

		.toc {
			display: none;
		}
	}

	@media (max-width: 780px) {
		.docs-shell {
			grid-template-columns: 1fr;
			width: min(100% - 24px, 1280px);
		}

		.sidebar {
			position: static;
			max-height: none;
			display: grid;
			gap: 6px;
		}
	}
</style>
