---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Header from '../components/Header.astro';
import SeriesArticleNav from '../components/SeriesArticleNav.astro';
import SeriesSidebar from '../components/SeriesSidebar.astro';
import { getBlogCategories, getPostCategory, tagSlug } from '../lib/blog';
import {
	getSeriesDefinition,
	getSeriesDefinitions,
	getSeriesPosts,
} from '../lib/series';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	currentId?: string;
	headings?: Heading[];
	readingMinutes?: number;
	seriesReaderId?: string;
};

const {
	title,
	description,
	tags,
	pubDate,
	updatedDate,
	heroImage,
	currentId,
	headings = [],
	readingMinutes = 1,
	seriesReaderId,
} = Astro.props;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = await getBlogCategories(posts);
const seriesDefinitions = await getSeriesDefinitions(posts);
const readerDefinition = getSeriesDefinition(seriesDefinitions, seriesReaderId);
const readerPosts = readerDefinition ? getSeriesPosts(posts, readerDefinition.id) : [];
const isSeriesReader = Boolean(readerDefinition && readerPosts.some((post) => post.id === currentId));
const currentPost = posts.find((post) => post.id === currentId);
const currentCategory = currentPost ? getPostCategory(currentPost, categories) : undefined;
const visibleHeadings = headings.filter((heading) => heading.depth <= 3);
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			canonicalPath={isSeriesReader && currentId ? `/blog/${currentId}/` : undefined}
		/>
	</head>
	<body>
		<div class="reading-progress" data-reading-progress aria-hidden="true"></div>
		<Header />
		<main class="docs-shell">
			<div class="desktop-sidebar">
				{
					isSeriesReader && readerDefinition ? (
						<SeriesSidebar definition={readerDefinition} posts={readerPosts} currentId={currentId} />
					) : (
						<BlogSidebar posts={posts} currentId={currentId} />
					)
				}
			</div>

			<article class="content">
				<div class="mobile-doc-navigation">
					<details>
						<summary>文章导航</summary>
						<div>
							{
								isSeriesReader && readerDefinition ? (
									<SeriesSidebar definition={readerDefinition} posts={readerPosts} currentId={currentId} />
								) : (
									<BlogSidebar posts={posts} currentId={currentId} />
								)
							}
						</div>
					</details>
					{
						visibleHeadings.length > 0 && (
							<details>
								<summary>本页目录</summary>
								<nav aria-label="移动端文章目录">
									{visibleHeadings.map((heading) => (
										<a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>
											{heading.text}
										</a>
									))}
								</nav>
							</details>
						)
					}
				</div>
				<a
					class="post-context"
					href={isSeriesReader ? '/series/' : '/blog'}
				>
					<span aria-hidden="true">←</span>
					{isSeriesReader ? readerDefinition?.title : currentCategory?.title ?? '文章'}
				</a>
				<header class="post-head">
					<h1>{title}</h1>
					<p>{description}</p>
					<div class="meta">
						<FormattedDate date={pubDate} />
						<span>{readingMinutes} 分钟阅读</span>
					</div>
				</header>
				<div class="prose">
					<slot />
				</div>
				<footer class="post-foot-meta">
					<div class="post-tags" aria-label="文章标签">
						{tags.map((tag) => <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>)}
					</div>
					{updatedDate && <p>更新于 <FormattedDate date={updatedDate} /></p>}
				</footer>
				<SeriesArticleNav posts={posts} currentId={currentId} readerSeriesId={seriesReaderId} />
				<GiscusComments />
			</article>

			<aside class="toc" aria-label="文章目录">
				<h2>目录</h2>
				{
					visibleHeadings.length > 0 ? (
						visibleHeadings.map((heading) => (
							<a class={`depth-${heading.depth}`} data-toc-link={heading.slug} href={`#${heading.slug}`}>
								{heading.text}
							</a>
						))
					) : (
						<p>暂无目录</p>
					)
				}
			</aside>
		</main>
		<Footer />
	</body>
</html>

<script>
	const readingProgress = document.querySelector('[data-reading-progress]');
	const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
	const headingPairs = tocLinks
		.map((link) => {
			const slug = link.getAttribute('data-toc-link');
			const heading = slug ? document.getElementById(slug) : null;
			return heading ? { heading, link } : null;
		})
		.filter(Boolean);

	function setActiveToc(activeLink) {
		tocLinks.forEach((link) => link.classList.remove('active'));
		activeLink?.classList.add('active');
	}

	function updateActiveToc() {
		const offset = 112;
		let current = headingPairs[0];

		for (const pair of headingPairs) {
			const top = pair.heading.getBoundingClientRect().top;
			if (top <= offset) {
				current = pair;
			} else {
				break;
			}
		}

		if (current) setActiveToc(current.link);
	}

	if (headingPairs.length > 0) {
		tocLinks.forEach((link) => {
			link.addEventListener('click', () => setActiveToc(link));
		});

		window.addEventListener('scroll', updateActiveToc, { passive: true });
		window.addEventListener('resize', updateActiveToc);
		updateActiveToc();
	}

	function updateReadingProgress() {
		if (!readingProgress) return;
		const scrollable = document.documentElement.scrollHeight - window.innerHeight;
		const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
		readingProgress.style.transform = `scaleX(${progress})`;
	}

	document.querySelectorAll('.prose pre').forEach((pre) => {
		const code = pre.querySelector('code');
		if (!code || pre.querySelector('.code-toolbar')) return;

		const toolbar = document.createElement('div');
		const language = document.createElement('span');
		const copyButton = document.createElement('button');
		const languageClass = Array.from(code.classList).find((item) => item.startsWith('language-'));

		toolbar.className = 'code-toolbar';
		language.textContent = languageClass?.replace('language-', '') || pre.dataset.language || 'CODE';
		copyButton.type = 'button';
		copyButton.textContent = '复制';
		copyButton.setAttribute('aria-label', '复制代码');
		copyButton.addEventListener('click', async () => {
			await navigator.clipboard.writeText(code.textContent || '');
			copyButton.textContent = '已复制';
			window.setTimeout(() => {
				copyButton.textContent = '复制';
			}, 1600);
		});

		toolbar.append(language, copyButton);
		pre.prepend(toolbar);
	});

	document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((heading) => {
		if (heading.querySelector('.heading-anchor')) return;
		const anchor = document.createElement('a');
		anchor.className = 'heading-anchor';
		anchor.href = `#${heading.id}`;
		anchor.textContent = '#';
		anchor.setAttribute('aria-label', `链接到 ${heading.textContent || '本节'}`);
		heading.append(anchor);
	});

	window.addEventListener('scroll', updateReadingProgress, { passive: true });
	window.addEventListener('resize', updateReadingProgress);
	updateReadingProgress();
</script>

<style>
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 100;
		width: 100%;
		height: 3px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
		will-change: transform;
	}

	.docs-shell {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr) 210px;
		gap: 32px;
		align-items: start;
		width: min(100% - 48px, 1500px);
	}

	.desktop-sidebar,
	.content {
		min-width: 0;
	}

	.content,
	.post-head,
	.prose {
		max-width: 100%;
	}

	.post-context {
		display: inline-flex;
		align-items: center;
		margin-bottom: 1.25rem;
		gap: 0.42rem;
		color: var(--accent-strong);
		font-size: 0.82rem;
		font-weight: 750;
	}

	.post-context:hover {
		color: var(--link-hover);
		transform: translateX(-2px);
	}

	.post-context small {
		font: inherit;
	}

	.post-head {
		margin-bottom: 38px;
		padding-bottom: 32px;
		border-bottom: 1px solid rgba(var(--line), 0.92);
	}

	h1 {
		max-width: 940px;
		margin-bottom: 1rem;
		color: var(--heading);
		font-size: clamp(2.2rem, 3.3vw, 2.8rem);
		line-height: 1.18;
		overflow-wrap: anywhere;
	}

	.post-head p {
		max-width: 920px;
		margin-bottom: 1.15rem;
		color: rgb(var(--muted));
		font-size: 1.02rem;
		line-height: 1.72;
		overflow-wrap: anywhere;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 18px;
		color: rgb(var(--muted));
		font-size: 0.84rem;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		gap: 7px;
	}

	.post-tags a {
		padding: 0.08rem 0;
		color: rgb(var(--muted));
		font-size: 0.75rem;
		font-weight: 700;
	}

	.post-tags a:hover {
		color: var(--accent-strong);
	}

	.meta > * + *::before {
		margin-right: 14px;
		color: rgb(var(--line));
		content: "•";
	}

	.prose {
		padding-bottom: 34px;
		font-size: 1.035rem;
		line-height: 1.82;
		overflow-wrap: anywhere;
	}

	.prose :global(h2) {
		position: relative;
		margin-top: 2.4rem;
		padding-top: 0.2rem;
		color: var(--heading);
		font-size: 1.7rem;
	}

	.prose :global(h3) {
		position: relative;
		margin-top: 1.7rem;
		color: var(--heading);
		font-size: 1.24rem;
	}

	.prose :global(p),
	.prose :global(li) {
		color: rgb(var(--ink));
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.35rem;
	}

	.prose :global(.heading-anchor) {
		margin-left: 0.45rem;
		color: rgba(120, 151, 127, 0.58);
		font-weight: 500;
		opacity: 0;
	}

	.prose :global(h2:hover .heading-anchor),
	.prose :global(h3:hover .heading-anchor),
	.prose :global(.heading-anchor:focus-visible) {
		opacity: 1;
	}

	.prose :global(pre:has(.code-toolbar)) {
		padding-top: 3.3rem;
	}

	.prose :global(.code-toolbar) {
		position: absolute;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 0.58rem 0.8rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.09);
		color: rgba(255, 255, 255, 0.5);
		font-family: var(--font-atkinson), sans-serif;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.prose :global(.code-toolbar button) {
		padding: 0.18rem 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 5px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.7);
		cursor: pointer;
		font: inherit;
		letter-spacing: 0;
	}

	.prose :global(.code-toolbar button:hover) {
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
	}

	.toc {
		position: sticky;
		top: 92px;
		max-height: calc(100vh - 130px);
		overflow: auto;
		padding-left: 18px;
		border-left: 1px solid rgba(var(--line), 0.95);
	}

	.toc h2 {
		margin-bottom: 0.65rem;
		font-size: 0.98rem;
	}

	.toc a,
	.toc p {
		display: block;
		margin: 0;
		padding: 0.34rem 0;
		color: rgb(var(--muted));
		font-size: 0.9rem;
		line-height: 1.35;
	}

	.toc a:hover {
		color: rgb(var(--ink));
	}

	.toc a:focus,
	.toc a:visited {
		color: rgb(var(--muted));
	}

	.toc a.active {
		color: var(--accent-strong);
		font-weight: 800;
	}

	.post-foot-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 0;
		gap: 20px;
		border-top: 1px solid rgba(var(--line), 0.9);
		color: rgb(var(--muted));
	}

	.post-foot-meta p {
		margin: 0;
		font-size: 0.76rem;
		white-space: nowrap;
	}

	.mobile-doc-navigation {
		display: none;
	}

	.toc .depth-3 {
		padding-left: 0.9rem;
		font-size: 0.86rem;
	}

	@media (max-width: 1260px) {
		.docs-shell {
			grid-template-columns: 230px minmax(0, 1fr);
			width: min(100% - 40px, 1120px);
		}

		.toc {
			display: none;
		}
	}

	@media (max-width: 920px) {
		.docs-shell {
			grid-template-columns: 1fr;
			width: min(100% - 32px, 900px);
		}

		.desktop-sidebar {
			display: none;
		}

		.mobile-doc-navigation {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			margin-bottom: 30px;
			gap: 10px;
		}

		.mobile-doc-navigation > details {
			position: relative;
		}

		.mobile-doc-navigation summary {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 42px;
			border: 1px solid rgba(var(--line), 0.92);
			border-radius: 8px;
			background: rgb(var(--card));
			color: rgb(var(--ink));
			cursor: pointer;
			font-size: 0.82rem;
			font-weight: 750;
			list-style: none;
		}

		.mobile-doc-navigation summary::-webkit-details-marker {
			display: none;
		}

		.mobile-doc-navigation details[open] summary {
			border-color: rgba(var(--accent), 0.5);
			background: var(--accent-soft);
			color: var(--accent-strong);
		}

		.mobile-doc-navigation details > div,
		.mobile-doc-navigation details > nav {
			position: absolute;
			top: calc(100% + 8px);
			left: 0;
			z-index: 20;
			width: min(420px, calc(100vw - 32px));
			max-height: 68vh;
			overflow: auto;
			padding: 8px;
			border: 1px solid rgba(var(--line), 0.92);
			border-radius: 10px;
			background: rgb(var(--card));
			box-shadow: var(--shadow);
		}

		.mobile-doc-navigation details:nth-child(2) > nav {
			right: 0;
			left: auto;
			display: grid;
			padding: 14px;
			gap: 2px;
		}

		.mobile-doc-navigation nav a {
			padding: 0.5rem 0.6rem;
			border-radius: 6px;
			color: rgb(var(--muted));
			font-size: 0.82rem;
			line-height: 1.4;
		}

		.mobile-doc-navigation nav .depth-3 {
			padding-left: 1.35rem;
		}
	}

	@media (max-width: 620px) {
		.docs-shell {
			width: min(100% - 24px, 900px);
		}

		.content,
		.post-head,
		.prose {
			min-width: 0;
			width: 100%;
		}

		h1 {
			font-size: clamp(1.9rem, 9vw, 2.35rem);
			line-height: 1.22;
		}

		.post-head p {
			font-size: 0.96rem;
		}

		.prose {
			font-size: 1rem;
		}

		.post-foot-meta {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
