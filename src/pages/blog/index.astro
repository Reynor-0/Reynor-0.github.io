---
import { getCollection } from 'astro:content';
import ArticleRow from '../../components/ArticleRow.astro';
import BaseHead from '../../components/BaseHead.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projectCount = posts.filter((post) => post.data.category === '项目').length;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="articles-shell">
			<header class="page-head">
				<div>
					<p class="eyebrow">ALL ARTICLES</p>
					<h1>所有文章</h1>
					<p>把问题、判断与答案放回同一条时间线。</p>
				</div>
				<a class="search-shortcut" href="/search">
					<svg viewBox="0 0 20 20" aria-hidden="true">
						<circle cx="8.5" cy="8.5" r="5.2" />
						<path d="m12.4 12.4 4 4" />
					</svg>
					搜索 {posts.length} 篇文章
				</a>
			</header>

			<div class="article-layout">
				<BlogSidebar posts={posts} overviewActive />
				<section class="article-main" aria-labelledby="article-list-title">
					<div class="list-head">
						<div>
							<h2 id="article-list-title">最近更新</h2>
							<p>包含技术笔记、问题复盘、阅读摘记与项目记录。</p>
						</div>
						<span>{posts.length} 篇文章 · {projectCount} 个项目</span>
					</div>
					<div class="article-list">
						{posts.map((post) => <ArticleRow post={post} />)}
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.articles-shell {
		width: min(100% - 40px, 1300px);
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 42px;
		padding-bottom: 34px;
		gap: 32px;
		border-bottom: 1px solid rgba(var(--line), 0.86);
	}

	.eyebrow {
		margin-bottom: 0.5rem;
		color: var(--accent-strong);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.16em;
	}

	.page-head h1 {
		margin-bottom: 0.55rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: clamp(2.5rem, 6vw, 4.2rem);
	}

	.page-head p:last-child {
		margin: 0;
		color: rgb(var(--muted));
	}

	.search-shortcut {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 1rem;
		gap: 8px;
		border: 1px solid rgba(var(--line), 0.82);
		border-radius: 999px;
		background: rgba(var(--card), 0.75);
		color: rgb(var(--muted));
		font-size: 0.84rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.search-shortcut:hover {
		border-color: rgba(var(--accent), 0.44);
		background: var(--accent-soft);
		color: var(--accent-strong);
		transform: translateY(-1px);
	}

	.search-shortcut svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.8;
	}

	.article-layout {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr);
		align-items: start;
		gap: 42px;
	}

	.article-main {
		min-width: 0;
	}

	.list-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 10px;
		gap: 24px;
	}

	.list-head h2 {
		margin-bottom: 0.35rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.55rem;
	}

	.list-head p,
	.list-head > span {
		margin: 0;
		color: rgb(var(--muted));
		font-size: 0.84rem;
	}

	.list-head > span {
		padding-bottom: 0.25rem;
		white-space: nowrap;
	}

	@media (max-width: 850px) {
		.articles-shell {
			width: min(100% - 24px, 1300px);
		}

		.page-head,
		.list-head {
			align-items: flex-start;
			flex-direction: column;
		}

		.article-layout {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
</style>
