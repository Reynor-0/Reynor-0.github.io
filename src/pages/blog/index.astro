---
import { getCollection } from 'astro:content';
import ArticleRow from '../../components/ArticleRow.astro';
import BaseHead from '../../components/BaseHead.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="articles-shell">
			<header class="page-head">
				<div>
					<h1>所有文章</h1>
					<p>把问题、判断与答案放回同一条时间线。</p>
				</div>
				<div class="page-actions">
					<a class="series-shortcut" href="/series">
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<path d="M4 3.5h9.5A2.5 2.5 0 0 1 16 6v10.5H6.5A2.5 2.5 0 0 1 4 14V3.5Z" />
							<path d="M6.5 13.5H16M7 7h6M7 10h4" />
						</svg>
						浏览技术专栏
					</a>
					<a class="search-shortcut" href="/search">
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<circle cx="8.5" cy="8.5" r="5.2" />
							<path d="m12.4 12.4 4 4" />
						</svg>
						搜索文章
					</a>
				</div>
			</header>

			<div class="article-layout">
				<BlogSidebar posts={posts} overviewActive />
				<section class="article-main" aria-labelledby="article-list-title">
					<div class="list-head">
						<div>
							<h2 id="article-list-title">最近更新</h2>
							<p>包含技术笔记、问题复盘、阅读摘记与项目记录。</p>
						</div>
						<span>{posts.length} 篇文章</span>
					</div>
					<div class="article-list">
						{posts.map((post) => <ArticleRow post={post} />)}
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.articles-shell {
		width: min(100% - 40px, 1300px);
	}

	.page-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 42px;
		padding-bottom: 34px;
		gap: 32px;
		border-bottom: 1px solid rgba(var(--line), 0.86);
	}

	.page-head h1 {
		margin-bottom: 0.55rem;
		color: var(--heading);
		font-size: clamp(2.5rem, 6vw, 4.2rem);
	}

	.page-head p:last-child {
		margin: 0;
		color: rgb(var(--muted));
	}

	.page-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 9px;
	}

	.search-shortcut,
	.series-shortcut {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0.25rem 0;
		gap: 8px;
		border-bottom: 1px solid transparent;
		color: rgb(var(--muted));
		font-size: 0.84rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.search-shortcut:hover,
	.series-shortcut:hover {
		border-color: var(--accent);
		color: var(--accent-strong);
	}

	.search-shortcut svg,
	.series-shortcut svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.8;
	}

	.series-shortcut {
		color: var(--accent-strong);
	}

	.article-layout {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr);
		align-items: start;
		gap: 42px;
	}

	.article-main {
		min-width: 0;
	}

	.list-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 10px;
		gap: 24px;
	}

	.list-head h2 {
		margin-bottom: 0.35rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.55rem;
	}

	.list-head p,
	.list-head > span {
		margin: 0;
		color: rgb(var(--muted));
		font-size: 0.84rem;
	}

	.list-head > span {
		padding-bottom: 0.25rem;
		white-space: nowrap;
	}

	@media (max-width: 850px) {
		.articles-shell {
			width: min(100% - 24px, 1300px);
		}

		.page-head,
		.list-head {
			align-items: flex-start;
			flex-direction: column;
		}

		.article-layout {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
</style>
