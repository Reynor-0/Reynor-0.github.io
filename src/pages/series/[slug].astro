---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SeriesEmpty from '../../components/SeriesEmpty.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { estimateReadingMinutes } from '../../lib/blog';
import { getSeriesDefinitions, getSeriesPosts, type SeriesDefinition } from '../../lib/series';

type Props = {
	definition: SeriesDefinition;
	post?: CollectionEntry<'blog'>;
};

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const definitions = await getSeriesDefinitions(posts);

	return definitions.map((definition) => ({
		params: { slug: definition.id },
		props: {
			definition,
			post: getSeriesPosts(posts, definition.id)[0],
		},
	}));
}

const { definition, post } = Astro.props;
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
const rawBody = post && 'body' in post && typeof post.body === 'string' ? post.body : '';
const readingMinutes = estimateReadingMinutes(rawBody);
---

{
	post && Content ? (
		<BlogPost
			{...post.data}
			currentId={post.id}
			headings={rendered?.headings ?? []}
			readingMinutes={readingMinutes}
			seriesReaderId={definition.id}
		>
			<Content />
		</BlogPost>
	) : (
		<SeriesEmpty definition={definition} />
	)
}
