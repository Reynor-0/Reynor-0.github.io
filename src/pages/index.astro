---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArticleRow from '../components/ArticleRow.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroDesktop from '../assets/home-meadow-oil-desktop.png';
import HeroMobile from '../assets/home-meadow-oil-mobile.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { tagSlug } from '../lib/blog';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = allPosts.slice(0, 5);
const projectPosts = allPosts.filter((post) => post.data.category === '项目').slice(0, 3);
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
	post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});
const popularTags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'))
	.slice(0, 12);
const mobileHero = await getImage({ src: HeroMobile, format: 'webp' });
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={HeroDesktop} />
	</head>
	<body>
		<Header overlay />
		<main class="home">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-art" aria-hidden="true">
					<picture>
						<source media="(max-width: 650px)" srcset={mobileHero.src} />
						<Image src={HeroDesktop} alt="" loading="eager" fetchpriority="high" />
					</picture>
				</div>
				<div class="hero-content">
					<h1 id="hero-title" aria-label="Reynor 知识库">
						<span data-hero-type aria-hidden="true">Reynor 知识库</span><i aria-hidden="true"></i>
					</h1>
				</div>
				<a class="hero-cue" href="#recent" aria-label="向下浏览最近文章">
					<svg viewBox="0 0 28 28" aria-hidden="true">
						<path d="m6 10 8 8 8-8" />
					</svg>
				</a>
			</section>

			<section class="journal" id="recent" aria-labelledby="recent-title" data-reveal>
				<div class="latest">
					<div class="section-head">
						<h2 id="recent-title">最近文章</h2>
						<a href="/blog">查看全部 <span aria-hidden="true">→</span></a>
					</div>
					<div class="recent-list">
						{recentPosts.map((post) => <ArticleRow post={post} compact />)}
					</div>
				</div>

				<aside class="home-aside">
					<section class="profile">
						<div>
							<h2>你好，我是 Reynor。</h2>
							<p>这里记录平常在学习和工作中遇到的问题和答案。</p>
						</div>
						<a href="/about">更多关于我 <span aria-hidden="true">→</span></a>
					</section>

					<section class="tag-panel">
						<div class="aside-title">
							<h2>常用标签</h2>
							<a href="/tags">全部标签</a>
						</div>
						<div class="tag-cloud">
							{
								popularTags.map(([tag, count]) => (
									<a href={`/tags/${tagSlug(tag)}/`}>
										{tag}<small>{count}</small>
									</a>
								))
							}
						</div>
					</section>
				</aside>
			</section>

			<section class="projects" aria-labelledby="projects-title" data-reveal>
				<div class="projects-head">
					<h2 id="projects-title">正在积累的项目</h2>
				</div>
				<div class="project-list">
					{
						projectPosts.map((post, index) => (
							<a href={`/blog/${post.id}/`}>
								<span>0{index + 1}</span>
								<div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
								<strong aria-hidden="true">↗</strong>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const initializeHomeMotion = () => {
		const hero = document.querySelector('.hero');
		const typeTarget = document.querySelector('[data-hero-type]');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (typeTarget instanceof HTMLElement && typeTarget.dataset.bound !== 'true') {
			typeTarget.dataset.bound = 'true';
			const text = 'Reynor 知识库';
			if (reducedMotion) {
				typeTarget.textContent = text;
			} else {
				typeTarget.textContent = '';
				let index = 0;
				const typeNext = () => {
					typeTarget.textContent = text.slice(0, index + 1);
					index += 1;
					if (index < text.length) window.setTimeout(typeNext, index < 7 ? 78 : 105);
					else typeTarget.closest('h1')?.classList.add('typing-complete');
				};
				window.setTimeout(typeNext, 280);
			}
		}

		if (hero instanceof HTMLElement && hero.dataset.parallaxBound !== 'true') {
			hero.dataset.parallaxBound = 'true';
			const updateParallax = () => {
				const shift = reducedMotion ? 0 : Math.min(window.scrollY * 0.018, 10);
				hero.style.setProperty('--hero-shift', `${shift}px`);
			};
			window.addEventListener('scroll', updateParallax, { passive: true });
			updateParallax();
		}

		const revealItems = document.querySelectorAll('[data-reveal]');
		if (reducedMotion || !('IntersectionObserver' in window)) {
			revealItems.forEach((item) => item.classList.add('is-visible'));
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				});
			},
			{ threshold: 0.08 },
		);
		revealItems.forEach((item) => observer.observe(item));
	};

	document.addEventListener('astro:page-load', initializeHomeMotion);
	initializeHomeMotion();
</script>

<style>
	.home {
		width: 100%;
		padding: 0;
	}

	.hero {
		position: relative;
		display: grid;
		min-height: 100svh;
		place-items: center;
		overflow: hidden;
	}

	.hero-art {
		position: absolute;
		inset: 0;
		transform: translateY(var(--hero-shift, 0));
		will-change: transform;
	}

	.hero-art picture,
	.hero-art :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-art :global(img) {
		object-fit: cover;
		object-position: center center;
		border-radius: 0;
		filter: var(--hero-image-filter);
		animation: hero-art-enter 1.4s cubic-bezier(0.2, 0.72, 0.2, 1) both;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: min(100% - 36px, 900px);
		text-align: center;
	}

	.hero h1 {
		display: inline-flex;
		align-items: center;
		margin: 0;
		color: var(--hero-heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: clamp(3rem, 6.2vw, 5.4rem);
		font-weight: 700;
		letter-spacing: -0.05em;
		text-shadow: 0 2px 22px rgba(var(--hero-shadow), 0.72);
	}

	.hero h1 i {
		display: inline-block;
		width: 2px;
		height: 0.82em;
		margin-left: 0.12em;
		background: currentColor;
		animation: caret-blink 620ms steps(1, end) infinite;
	}

	.hero h1.typing-complete i {
		animation: caret-finish 1.05s steps(1, end) forwards;
	}

	.hero-cue {
		position: absolute;
		bottom: 26px;
		left: 50%;
		z-index: 2;
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid rgba(var(--glass), 0.72);
		border-radius: 50%;
		background: rgba(var(--glass), 0.28);
		color: var(--hero-heading);
		backdrop-filter: blur(10px);
		transform: translateX(-50%);
		animation: cue-float 1.8s ease-in-out infinite;
	}

	.hero-cue:hover {
		background: rgba(var(--glass), 0.62);
	}

	.hero-cue svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.journal {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(280px, 0.72fr);
		width: min(100% - 64px, 1200px);
		margin: 0 auto;
		padding: 72px 0 118px;
		gap: 76px;
	}

	.section-head,
	.aside-title,
	.projects-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
	}

	.section-head {
		margin-bottom: 18px;
	}

	.section-head h2,
	.projects h2 {
		margin: 0;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
	}

	.section-head > a,
	.profile > a,
	.aside-title > a {
		font-size: 0.8rem;
		font-weight: 800;
	}

	.home-aside {
		display: grid;
		align-content: start;
		gap: 18px;
	}

	.profile {
		padding: 0 0 2rem;
		border-bottom: 1px solid rgba(var(--line), 0.92);
	}

	.profile h2 {
		margin-bottom: 0.7rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.35rem;
	}

	.profile div > p:last-child {
		color: rgb(var(--muted));
		font-size: 0.88rem;
	}

	.profile > a {
		display: inline-flex;
		margin-top: 0.45rem;
	}

	.tag-panel {
		padding: 0;
	}

	.aside-title {
		margin-bottom: 1rem;
	}

	.aside-title h2 {
		margin: 0;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.12rem;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}

	.tag-cloud a {
		display: inline-flex;
		align-items: center;
		padding: 0.15rem 0;
		gap: 5px;
		color: rgb(var(--muted));
		font-size: 0.74rem;
	}

	.tag-cloud a::before {
		color: var(--accent-strong);
		content: "#";
	}

	.tag-cloud a:hover {
		color: var(--accent-strong);
	}

	.tag-cloud small {
		color: var(--accent-strong);
		font-size: 0.64rem;
		font-weight: 800;
	}

	.projects {
		width: min(100% - 64px, 1200px);
		margin: 0 auto 78px;
		padding: 0;
	}

	.projects-head {
		margin-bottom: 24px;
	}

	.project-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid rgba(var(--line), 0.9);
	}

	.project-list > a {
		display: grid;
		grid-template-columns: auto 1fr auto;
		padding: 1.25rem 1.15rem;
		gap: 14px;
		border-bottom: 1px solid rgba(var(--line), 0.78);
		color: rgb(var(--ink));
	}

	.project-list > a + a {
		border-left: 1px solid rgba(var(--line), 0.72);
	}

	.project-list > a:hover {
		background: rgba(var(--soft), 0.72);
		transform: translateY(-2px);
	}

	.project-list span,
	.project-list strong {
		color: var(--accent-strong);
		font-size: 0.75rem;
	}

	.project-list h3 {
		margin-bottom: 0.35rem;
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1rem;
	}

	.project-list p {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: rgb(var(--muted));
		font-size: 0.78rem;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	[data-reveal] {
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 360ms ease,
			transform 360ms ease;
	}

	[data-reveal].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@keyframes hero-art-enter {
		from { opacity: 0.84; transform: scale(1.025); }
		to { opacity: 1; transform: scale(1); }
	}

	@keyframes caret-blink {
		0%, 48% { opacity: 1; }
		49%, 100% { opacity: 0; }
	}

	@keyframes caret-finish {
		0%, 30%, 60% { opacity: 1; }
		15%, 45%, 75%, 100% { opacity: 0; }
	}

	@keyframes cue-float {
		0%,
		100% { transform: translate(-50%, 0); }
		50% { transform: translate(-50%, 8px); }
	}

	@media (max-width: 900px) {
		.journal {
			grid-template-columns: 1fr;
			gap: 42px;
		}

		.home-aside {
			grid-template-columns: 1fr 1fr;
		}

		.project-list {
			grid-template-columns: 1fr;
		}

		.project-list > a + a {
			border-left: 0;
		}
	}

	@media (max-width: 650px) {
		.hero-art :global(img) {
			object-position: center center;
		}

		.hero-content {
			width: min(100% - 28px, 900px);
		}

		.hero h1 {
			max-width: 100%;
			font-size: clamp(2.15rem, 9.7vw, 2.55rem);
			letter-spacing: -0.055em;
			white-space: nowrap;
		}

		.journal,
		.projects {
			width: min(100% - 28px, 1200px);
		}

		.journal {
			padding-bottom: 72px;
		}

		.home-aside {
			grid-template-columns: 1fr;
		}

		.projects {
			padding: 28px 22px 18px;
		}

		.projects-head {
			align-items: flex-start;
			flex-direction: column;
		}

		.projects-head > p {
			text-align: left;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-art :global(img),
		.hero-cue,
		.hero h1 i {
			animation: none;
		}

		[data-reveal] {
			opacity: 1;
			transform: none;
		}
	}
</style>
