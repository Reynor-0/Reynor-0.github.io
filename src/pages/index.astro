---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArticleRow from '../components/ArticleRow.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroArtwork from '../assets/home-oil-painting-v2.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { tagSlug } from '../lib/blog';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = allPosts.slice(0, 5);
const projectPosts = allPosts.filter((post) => post.data.category === '项目').slice(0, 3);
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
	post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});
const popularTags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'))
	.slice(0, 12);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={HeroArtwork} />
	</head>
	<body>
		<Header overlay />
		<main class="home">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-art" aria-hidden="true">
					<Image src={HeroArtwork} alt="" loading="eager" fetchpriority="high" />
				</div>
				<div class="hero-content">
					<h1 id="hero-title">Reynor知识库</h1>
				</div>
				<a class="hero-cue" href="#recent" aria-label="向下浏览最近文章">
					<svg viewBox="0 0 28 28" aria-hidden="true">
						<path d="m6 10 8 8 8-8" />
					</svg>
				</a>
			</section>

			<section class="journal" id="recent" aria-labelledby="recent-title">
				<div class="latest">
					<div class="section-head">
						<div>
							<p>RECENT WRITING</p>
							<h2 id="recent-title">最近文章</h2>
						</div>
						<a href="/blog">查看全部 <span aria-hidden="true">→</span></a>
					</div>
					<div class="recent-list">
						{recentPosts.map((post) => <ArticleRow post={post} compact />)}
					</div>
				</div>

				<aside class="home-aside">
					<section class="profile">
						<div class="profile-mark" aria-hidden="true">✦</div>
						<div>
							<p class="profile-kicker">ABOUT THE AUTHOR</p>
							<h2>你好，我是 Reynor。</h2>
							<p>这里记录平常在学习和工作中遇到的问题和答案。</p>
						</div>
						<a href="/about">更多关于我 <span aria-hidden="true">→</span></a>
					</section>

					<section class="tag-panel">
						<div class="aside-title">
							<h2>常用标签</h2>
							<a href="/tags">全部标签</a>
						</div>
						<div class="tag-cloud">
							{
								popularTags.map(([tag, count]) => (
									<a href={`/tags/${tagSlug(tag)}/`}>
										{tag}<small>{count}</small>
									</a>
								))
							}
						</div>
					</section>
				</aside>
			</section>

			<section class="projects" aria-labelledby="projects-title">
				<div class="projects-head">
					<div>
						<p>PROJECT NOTES</p>
						<h2 id="projects-title">正在积累的项目</h2>
					</div>
					<p>项目不再单独成站，它们也是文章，是过程、判断与结果的连续记录。</p>
				</div>
				<div class="project-list">
					{
						projectPosts.map((post, index) => (
							<a href={`/blog/${post.id}/`}>
								<span>0{index + 1}</span>
								<div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
								<strong aria-hidden="true">↗</strong>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 100%;
		padding: 0;
	}

	.hero {
		position: relative;
		display: grid;
		min-height: 100svh;
		place-items: center;
		overflow: hidden;
	}

	.hero-art {
		position: absolute;
		inset: 0;
	}

	.hero-art :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 58%;
		border-radius: 0;
		filter: var(--hero-image-filter);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: min(100% - 36px, 900px);
		text-align: center;
		animation: hero-enter 700ms ease-out both;
	}

	.hero h1 {
		margin: 0;
		color: var(--hero-heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: clamp(2.8rem, 6vw, 5.2rem);
		letter-spacing: -0.045em;
		text-shadow: 0 3px 28px rgba(var(--hero-shadow), 0.92);
	}

	.hero-cue {
		position: absolute;
		bottom: 26px;
		left: 50%;
		z-index: 2;
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid rgba(var(--glass), 0.72);
		border-radius: 50%;
		background: rgba(var(--glass), 0.28);
		color: var(--hero-heading);
		backdrop-filter: blur(10px);
		transform: translateX(-50%);
		animation: cue-float 1.8s ease-in-out infinite;
	}

	.hero-cue:hover {
		background: rgba(var(--glass), 0.62);
	}

	.hero-cue svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.journal {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(280px, 0.72fr);
		width: min(100% - 48px, 1180px);
		margin: 0 auto;
		padding: 48px 0 110px;
		gap: 64px;
	}

	.section-head,
	.aside-title,
	.projects-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
	}

	.section-head {
		margin-bottom: 18px;
	}

	.section-head p,
	.projects-head > div > p,
	.profile-kicker {
		margin-bottom: 0.4rem;
		color: var(--accent-strong);
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.16em;
	}

	.section-head h2,
	.projects h2 {
		margin: 0;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
	}

	.section-head > a,
	.profile > a,
	.aside-title > a {
		font-size: 0.8rem;
		font-weight: 800;
	}

	.home-aside {
		display: grid;
		align-content: start;
		gap: 18px;
	}

	.profile,
	.tag-panel {
		border: 1px solid rgba(var(--line), 0.72);
		border-radius: 18px;
		background:
			radial-gradient(circle at 100% 0, rgba(239, 191, 210, 0.18), transparent 13rem),
			rgba(var(--card), 0.78);
		box-shadow: 0 16px 44px rgba(76, 103, 137, 0.07);
	}

	.profile {
		padding: 1.7rem;
	}

	.profile-mark {
		display: grid;
		width: 58px;
		height: 58px;
		margin-bottom: 1.15rem;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(145deg, var(--accent-soft), var(--pink-soft));
		color: var(--accent-strong);
		font-size: 1.7rem;
	}

	.profile h2 {
		margin-bottom: 0.7rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.35rem;
	}

	.profile div > p:last-child {
		color: rgb(var(--muted));
		font-size: 0.88rem;
	}

	.profile > a {
		display: inline-flex;
		margin-top: 0.45rem;
	}

	.tag-panel {
		padding: 1.4rem 1.5rem 1.55rem;
	}

	.aside-title {
		margin-bottom: 1rem;
	}

	.aside-title h2 {
		margin: 0;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.12rem;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}

	.tag-cloud a {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.62rem;
		gap: 5px;
		border: 1px solid rgba(var(--line), 0.7);
		border-radius: 999px;
		background: rgba(var(--soft), 0.7);
		color: rgb(var(--muted));
		font-size: 0.74rem;
	}

	.tag-cloud a:hover {
		border-color: rgba(var(--pink), 0.44);
		background: var(--pink-soft);
		color: #bd6689;
	}

	.tag-cloud small {
		color: var(--accent-strong);
		font-size: 0.64rem;
		font-weight: 800;
	}

	.projects {
		width: min(100% - 48px, 1180px);
		margin: 0 auto 78px;
		padding: 38px 40px 28px;
		border: 1px solid rgba(var(--line), 0.74);
		border-radius: 22px;
		background:
			radial-gradient(circle at 0 100%, rgba(134, 169, 212, 0.14), transparent 20rem),
			radial-gradient(circle at 100% 0, rgba(239, 191, 210, 0.16), transparent 18rem),
			rgba(var(--card), 0.78);
	}

	.projects-head {
		margin-bottom: 24px;
	}

	.projects-head > p {
		max-width: 520px;
		margin: 0;
		color: rgb(var(--muted));
		font-size: 0.86rem;
		text-align: right;
	}

	.project-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}

	.project-list > a {
		display: grid;
		grid-template-columns: auto 1fr auto;
		padding: 1.25rem 1.15rem;
		gap: 14px;
		border-top: 1px solid rgba(var(--line), 0.78);
		color: rgb(var(--ink));
	}

	.project-list > a + a {
		border-left: 1px solid rgba(var(--line), 0.72);
	}

	.project-list > a:hover {
		background: rgba(var(--soft), 0.56);
		transform: translateY(-2px);
	}

	.project-list span,
	.project-list strong {
		color: var(--accent-strong);
		font-size: 0.75rem;
	}

	.project-list h3 {
		margin-bottom: 0.35rem;
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1rem;
	}

	.project-list p {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: rgb(var(--muted));
		font-size: 0.78rem;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	@keyframes hero-enter {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes cue-float {
		0%,
		100% { transform: translate(-50%, 0); }
		50% { transform: translate(-50%, 8px); }
	}

	@media (max-width: 900px) {
		.journal {
			grid-template-columns: 1fr;
			gap: 42px;
		}

		.home-aside {
			grid-template-columns: 1fr 1fr;
		}

		.project-list {
			grid-template-columns: 1fr;
		}

		.project-list > a + a {
			border-left: 0;
		}
	}

	@media (max-width: 650px) {
		.hero-art :global(img) {
			object-position: 44% center;
		}

		.hero-content {
			width: min(100% - 28px, 900px);
		}

		.hero h1 {
			font-size: clamp(2.65rem, 13vw, 4rem);
		}

		.journal,
		.projects {
			width: min(100% - 24px, 1180px);
		}

		.journal {
			padding-bottom: 72px;
		}

		.home-aside {
			grid-template-columns: 1fr;
		}

		.projects {
			padding: 28px 22px 18px;
		}

		.projects-head {
			align-items: flex-start;
			flex-direction: column;
		}

		.projects-head > p {
			text-align: left;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-content,
		.hero-cue {
			animation: none;
		}
	}
</style>
