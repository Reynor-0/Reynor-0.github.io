---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroArtwork from '../assets/home-oil-painting-v2.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={HeroArtwork} />
	</head>
	<body>
		<Header overlay />
		<main class="home">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-art" aria-hidden="true">
					<Image
						src={HeroArtwork}
						width={1718}
						height={1024}
						alt=""
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<div class="hero-content">
					<h1 id="hero-title">在学习里，慢慢留下自己的答案。</h1>
					<p>这里记录学习过程中的知识、遇到的问题，以及一步步找到答案的过程。</p>
					<a href="#recent">
						看看最近记录
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<path d="M4 10h11m-4-4 4 4-4 4" />
						</svg>
					</a>
				</div>
				<a class="scroll-cue" href="#recent" aria-label="继续向下浏览">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m6 9 6 6 6-6" />
					</svg>
				</a>
			</section>

			<section class="recent" id="recent" aria-labelledby="recent-title">
				<div class="recent-head">
					<div>
						<h2 id="recent-title">最近记录</h2>
						<p>一些刚刚整理好的学习笔记与问题复盘。</p>
					</div>
					<a href="/blog">
						全部文章
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<path d="M4 10h11m-4-4 4 4-4 4" />
						</svg>
					</a>
				</div>

				<div class="recent-list">
					{
						posts.map((post) => (
							<a class="record" href={`/blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('zh-CN')}
								</time>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<span aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M7 17 17 7M8 7h9v9" />
									</svg>
								</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="personal-note">
				<p>
					不为内容预设边界。技术、阅读、项目，或偶尔冒出来的想法，都会在这里慢慢积累。
				</p>
				<a href="/about">关于这个博客</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 100%;
		padding: 0;
	}

	.hero {
		position: relative;
		display: grid;
		min-height: min(900px, 88svh);
		place-items: center;
		overflow: hidden;
	}

	.hero-art {
		position: absolute;
		inset: 0;
	}

	.hero-art :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center bottom;
		border-radius: 0;
		filter: var(--hero-image-filter);
		transition: filter 220ms ease;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		max-width: 850px;
		padding: 72px 24px 120px;
		flex-direction: column;
		text-align: center;
		animation: hero-enter 720ms ease-out both;
	}

	h1 {
		margin-bottom: 1.15rem;
		color: var(--hero-heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: clamp(2.7rem, 5.3vw, 4.8rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		text-shadow: 0 2px 18px rgba(var(--hero-shadow), 0.72);
	}

	.hero-content > p {
		max-width: 620px;
		margin-bottom: 1.8rem;
		color: var(--hero-muted);
		font-size: clamp(1rem, 1.5vw, 1.12rem);
		line-height: 1.8;
		text-shadow: 0 1px 12px rgba(var(--hero-shadow), 0.9);
	}

	.hero-content > a,
	.recent-head > a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		font-weight: 800;
	}

	.hero-content > a {
		min-height: 48px;
		padding: 0 1.25rem;
		border: 1px solid rgba(var(--glass), 0.78);
		border-radius: 12px;
		background: rgba(var(--glass), 0.62);
		box-shadow: 0 12px 30px rgba(85, 118, 160, 0.12);
		backdrop-filter: blur(14px);
		color: var(--accent-strong);
	}

	.hero-content > a:hover {
		background: rgba(var(--glass), 0.82);
		color: var(--link-hover);
		transform: translateY(-2px);
	}

	.hero-content svg,
	.recent-head svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 15%;
		z-index: 2;
		display: grid;
		width: 38px;
		height: 38px;
		place-items: center;
		border-radius: 50%;
		color: rgba(84, 116, 158, 0.72);
		transform: translateX(-50%);
		animation: cue-float 2.2s ease-in-out infinite;
	}

	.scroll-cue svg {
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.recent {
		width: min(100% - 48px, 1120px);
		margin: 0 auto;
		padding: 74px 0 112px;
	}

	.recent-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 28px;
		margin-bottom: 44px;
	}

	.recent-head h2 {
		margin-bottom: 0.5rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: clamp(2rem, 4vw, 3rem);
	}

	.recent-head p {
		margin: 0;
		color: rgb(var(--muted));
	}

	.recent-head > a {
		padding-bottom: 0.18rem;
		border-bottom: 1px solid rgba(95, 130, 178, 0.32);
		color: var(--accent-strong);
		font-size: 0.9rem;
	}

	.recent-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 34px;
	}

	.record {
		position: relative;
		display: flex;
		min-width: 0;
		padding: 1.45rem 0 1.1rem;
		flex-direction: column;
		border-top: 2px solid rgba(134, 169, 212, 0.36);
		color: rgb(var(--ink));
	}

	.record::before {
		position: absolute;
		top: -2px;
		left: 0;
		width: 0;
		height: 2px;
		background: linear-gradient(90deg, var(--accent), var(--pink));
		content: "";
		transition: width 240ms ease;
	}

	.record:hover {
		color: rgb(var(--ink));
		transform: translateY(-3px);
	}

	.record:hover::before {
		width: 100%;
	}

	.record time {
		margin-bottom: 0.75rem;
		color: rgb(var(--muted));
		font-size: 0.78rem;
		letter-spacing: 0.05em;
	}

	.record h3 {
		margin-bottom: 0.65rem;
		color: var(--heading);
		font-family: Georgia, "Noto Serif SC", "Songti SC", serif;
		font-size: 1.26rem;
		line-height: 1.45;
	}

	.record p {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: rgb(var(--muted));
		font-size: 0.92rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.record > span {
		display: grid;
		width: 34px;
		height: 34px;
		margin-top: 1.2rem;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(145deg, var(--accent-soft), var(--pink-soft));
		color: var(--accent-strong);
	}

	.record > span svg {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.personal-note {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 48px, 1120px);
		margin: 0 auto 72px;
		padding: 34px 38px;
		border: 1px solid rgba(134, 169, 212, 0.18);
		border-radius: 22px;
		background:
			radial-gradient(circle at 92% 0%, rgba(239, 191, 210, 0.2), transparent 16rem),
			linear-gradient(135deg, rgba(var(--soft), 0.88), rgba(var(--card), 0.96));
		gap: 28px;
	}

	.personal-note p {
		max-width: 740px;
		margin: 0;
		color: rgb(var(--muted));
	}

	.personal-note a {
		flex: 0 0 auto;
		font-weight: 800;
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes cue-float {
		0%,
		100% {
			transform: translate(-50%, 0);
		}
		50% {
			transform: translate(-50%, 7px);
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: 760px;
		}

		.hero-art :global(img) {
			object-position: 42% bottom;
		}

		.hero-content {
			padding: 132px 20px 160px;
		}

		h1 {
			font-size: clamp(2.45rem, 12vw, 3.7rem);
		}

		.scroll-cue {
			bottom: 12%;
		}

		.recent {
			width: min(100% - 24px, 1120px);
			padding: 52px 0 78px;
		}

		.recent-head {
			align-items: flex-start;
			flex-direction: column;
			margin-bottom: 28px;
		}

		.recent-list {
			grid-template-columns: 1fr;
			gap: 14px;
		}

		.personal-note {
			align-items: flex-start;
			width: min(100% - 24px, 1120px);
			margin-bottom: 42px;
			padding: 26px 24px;
			flex-direction: column;
		}
	}
</style>
